# Скопируйте в .env и подставьте свои значения.
# Локально через docker: docker run --name slay-db -e POSTGRES_PASSWORD=slay -e POSTGRES_DB=slay -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:slay@localhost:5432/slay?schema=public"

# Cloudflare Turnstile (CAPTCHA на регистрации).
# Без этих переменных в dev-режиме проверка CAPTCHA пропускается (см. src/lib/turnstile.ts),
# но в NODE_ENV=production регистрация без TURNSTILE_SECRET_KEY будет отклонена.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Яндекс.Карты — используется на странице оформления заказа для выбора адреса
# доставки на карте (клик/поиск -> автоподстановка в поле "Адрес").
# Получить ключ: https://developer.tech.yandex.ru/services/3
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=
# Отдельный ключ для подсказок адресов (SuggestView) — обязателен, без него подсказки не работают
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
